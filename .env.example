# Copy to .env for local development (`npm run dev`).
# The app must NOT read this file inside Docker - docker-compose.app.yml
# injects the container values (postgres / redis) as real env vars.

# # Application
PORT=3000

# # PostgreSQL (local: published by docker-compose.yml on 127.0.0.1)
DATABASE_URL=postgres://shop:shop@localhost:5432/shopflow
# DB_HOST=localhost
# DB_PORT=5432
# DB_USER=shop
# DB_PASSWORD=shop
# DB_NAME=shopflow

# # Redis
REDIS_URL=redis://localhost:6379
# REDIS_HOST=localhost
# REDIS_PORT=6379

# # JWT Authentication
# JWT_ACCESS_SECRET=your_access_secret
# JWT_REFRESH_SECRET=your_refresh_secret
# JWT_ACCESS_EXPIRES_IN=15m
# JWT_REFRESH_EXPIRES_IN=7d
